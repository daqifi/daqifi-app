<Window x:Class="Daqifi.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:flyouts="using:Daqifi.Desktop.View.Flyouts"
        xmlns:local="using:Daqifi.Desktop.View"
        xmlns:prototype="using:Daqifi.Desktop.View.Prototype"
        xmlns:converters="using:Daqifi.Desktop.Converters"
        xmlns:service="using:Daqifi.Desktop.DialogService"
        xmlns:vm="using:Daqifi.Desktop.ViewModels"
        x:DataType="vm:DaqifiViewModel"
        x:CompileBindings="True"
        service:DialogService.IsRegisteredView="True"
        Icon="avares://Daqifi.Avalonia/Daqifi.Desktop/Images/AppIcon.ico"
        Height="{Binding Height, Mode=TwoWay}"
        Width="{Binding Width, Mode=TwoWay}"
        MinWidth="720"
        MinHeight="480"
        WindowState="{Binding ViewWindowState, Mode=OneWayToSource}"
        Background="{DynamicResource Surface}">

    <!--
        MetroWindow → Window (hal: main_window_chrome): FluentTheme covers
        chrome + theming; GlowBrush/WindowTitleBrush have no counterpart.
        RightWindowCommands move to the client-area toolbar row below.
        The three MahApps flyouts are pane content of the ONE SplitView
        host (hal: flyout_host mechanism) — not independent slide-outs.
    -->

    <!--
        x:DataType + x:CompileBindings: all 32 bindings below are now resolved by the
        XAML compiler against DaqifiViewModel instead of by reflection at run time
        (issue #327). Both attributes are needed — AvaloniaUseCompiledBindingsByDefault
        is false in Daqifi.Avalonia.csproj, so x:DataType on its own buys IntelliSense
        and nothing else, which is the trap issue #326 was about.

        Measured on origin/main, one deliberate typo at a time: ten of the bindings here
        — the Window's own Height, a toolbar toggle, the notification badge's converter
        binding, a <Binding Path=/> child of the SplitView MultiBinding, both halves of
        an AppSettings.* path, the settings scrim's Command, the tab strip's
        SelectedIndex, a flyout IsVisible and the busy overlay's FallbackValue binding —
        each built with 0 Error(s) and no diagnostic naming this file. A bogus CLR
        property in the same tag did error, so the file was genuinely being compiled.
        On this branch each of the ten is AVLN2000 against DaqifiViewModel.

        The default matters more than it looks: a broken bool binding does not blank the
        control, it leaves the property at its DEFAULT, and IsVisible defaults to TRUE.
        Eight of the 32 bindings feed IsVisible, and five of those gate a whole surface —
        the settings drawer, the busy overlay and the three flyouts. A typo in any of the
        five pinned that surface permanently open over the app, and every head still
        built green.

        The five DataTemplates below deliberately carry NO x:DataType. Measured on
        Avalonia 12.1: a ContentControl.ContentTemplate infers no scope at all — its
        bindings resolve against XamlX.TypeSystem.XamlPseudoType, on which nothing
        resolves — and that holds even here, where Content="{Binding}" gives the
        compiler the DataContext type statically. That is a build error, not a silent
        re-scope, so an undeclared template cannot hide a broken binding. Since these
        five hold a bare pane element and bind nothing, a declaration would be pure
        decoration, and a stale one would be worse than none: an explicit x:DataType
        OVERRIDES the scope, so it keeps compiling against the type it names after the
        Content beside it has been repointed somewhere else.

        Content="{Binding}" on each of the five is load-bearing and easy to mistake for
        noise: it is what puts DaqifiViewModel into the pane's DataContext. LiveGraphPane
        and LoggedDataPanePrototype have no view model of their own and read it straight
        off the inherited DataContext, so deleting it blanks those two tabs. Pinned in
        MainWindowBindingTests.
    -->

    <Window.Resources>


        <!--
            Navigation rail — uses canonical design tokens from
            /Daqifi.Desktop/Resources/DesignTokens.axaml. See docs/design-philosophy.md.
            WPF ControlTemplate+Triggers → ControlTheme + pseudo-class selectors;
            the accent-stripe Storyboard becomes an opacity Transition.
            (NavTabItemFocusVisual dropped — Avalonia draws its own focus adorner.)
        -->

        <ControlTheme x:Key="NavTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}" ColumnDefinitions="3,*">
                        <Rectangle x:Name="AccentStripe"
                                   Grid.Column="0"
                                   Fill="{DynamicResource Accent}"
                                   Opacity="0">
                            <Rectangle.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                                </Transitions>
                            </Rectangle.Transitions>
                        </Rectangle>
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
            <Style Selector="^:selected /template/ Rectangle#AccentStripe">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pointerover:not(:selected)">
                <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="NavTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <!-- WPF TabStripPlacement="Left" stacked vertically; Avalonia's
                 default ItemsPanel is a WrapPanel, so pin a vertical stack. -->
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderDim}"
                                BorderThickness="0,0,1,0">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Column="1"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- RoundCloseButton moved to Resources/Shell.axaml (#613) so the three
             SplitView flyouts, which are separate UserControls, can use it too. -->

        <!-- Segmented toggle (upstream AppSettings.SegmentedToggle RadioButton template) -->
        <ControlTheme x:Key="SegmentedToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="2"
                            Padding="12,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#Bg">
                <Setter Property="Background" Value="{DynamicResource SurfaceActive}"/>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
        </ControlTheme>

    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.navTabHeaderLabel">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- MahApps WindowCommands buttons → flat toolbar buttons -->
        <Style Selector="Button.windowCommand, ToggleButton.windowCommand">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <!-- Top-bar labels (#618): capitals in the caption style the rest of the shell
             uses for its own labels (LOGGING OFF, IMPORT SD LOG, + ADD DEVICE), not
             lower case. -->
        <Style Selector="TextBlock.windowCommandLabel">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.windowCommand:pointerover, ToggleButton.windowCommand:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- Neutralize the Fluent ToggleButton default accent-fill on :checked so the
             settings/debug toggles don't light up blue when their drawer is open —
             the original MahApps RightWindowCommands stayed flat (#12). -->
        <Style Selector="ToggleButton.windowCommand:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.windowCommand:checked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style Selector="TextBlock.appSettingsHelpText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- MetroWindow.RightWindowCommands → client-area toolbar row -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderDim}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton Classes="windowCommand"
                              IsChecked="{Binding IsAppSettingsOpen}"
                              ToolTip.Tip="Settings">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="mdi-cog-outline" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Classes="windowCommandLabel" Text="SETTINGS"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Classes="windowCommand"
                              IsChecked="{Binding IsDebugModeEnabled}"
                              ToolTip.Tip="Toggle Debug Mode">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="mdi-bug-outline" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Classes="windowCommandLabel" Text="DEBUG"/>
                    </StackPanel>
                </ToggleButton>
                <Button Classes="windowCommand"
                        Command="{Binding OpenDebugWindowCommand}"
                        ToolTip.Tip="Open Debug Console"
                        IsVisible="{Binding IsDebugModeEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="mdi-console" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Classes="windowCommandLabel" Text="CONSOLE"/>
                    </StackPanel>
                </Button>
                <Button Classes="windowCommand" Command="{Binding OpenHelpCommand}"
                        ToolTip.Tip="Help">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="mdi-help-circle-outline" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Classes="windowCommandLabel" Text="HELP"/>
                    </StackPanel>
                </Button>
                <Button Classes="windowCommand" Command="{Binding OpenNotificationsCommand}"
                        ToolTip.Tip="Notifications">
                    <Grid>
                        <i:Icon Value="mdi-bell-outline" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border Background="{DynamicResource StatusRed}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="10"
                                Height="10"
                                CornerRadius="7.5"
                                Margin="5 0 0 0"
                                IsVisible="{Binding NotificationCount, Converter={StaticResource IntToVisibility}}">
                            <TextBlock Text="{Binding NotificationCount}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <!-- ONE SplitView flyout host (hal: flyout_host) — pane hosts all three
             former MahApps flyouts; VM booleans stay the source of truth. -->
        <!-- Fixed narrow drawer width to match the original MahApps flyouts, which
             rendered as a ~260-320px right-side drawer over the still-visible content.
             (The ported VM FlyoutWidth = Width - SidePanelWidth is near-full-width; a
             SplitView consumes OpenPaneLength literally, unlike a MahApps Flyout, so
             binding it produced a full-bleed panel that hid the pane — see #5.) -->
        <!--
            All four right-side panels live in this one pane since #615 — the settings drawer
            used to be a separate Grid overlay with its own scrim and no motion, so it looked and
            moved unlike the three flyouts. Now they share one header (DrawerHeader), one
            200 ms ease-out slide (the Fluent SplitView width transition, 100 ms to close), one
            scrim (UseLightDismissOverlayMode, tinted to the settings drawer's old 63 % black)
            and one hairline along the left edge. A click on the scrim, or Escape, closes the
            open panel; OnPaneClosing in the code-behind turns that into the view-model flag, and
            OnKeyDown takes Escape when focus is outside the pane (the top-bar button that opened
            it, for example), where the SplitView never sees the key.
        -->
        <SplitView x:Name="DrawerHost"
                   Grid.Row="1"
                   PanePlacement="Right"
                   DisplayMode="Overlay"
                   OpenPaneLength="380"
                   UseLightDismissOverlayMode="True"
                   PaneClosing="OnPaneClosing"
                   PaneBackground="{DynamicResource SurfaceRaised}">
            <SplitView.Resources>
                <SolidColorBrush x:Key="SplitViewLightDismissOverlayBackground" Color="#A0000000"/>
            </SplitView.Resources>
            <!-- One computed flag, not a MultiBinding over the four: see IsAnyDrawerOpen. -->
            <SplitView.IsPaneOpen>
                <Binding Path="IsAnyDrawerOpen" Mode="OneWay"/>
            </SplitView.IsPaneOpen>

            <SplitView.Pane>
                <Border BorderBrush="{DynamicResource BorderDim}" BorderThickness="1,0,0,0">
                <Panel>
                    <!-- ========== APP SETTINGS DRAWER ========== -->
                    <Grid IsVisible="{Binding IsAppSettingsOpen}" RowDefinitions="Auto,*">
                        <flyouts:DrawerHeader Grid.Row="0"
                                              Overline="PREFERENCES"
                                              Title="Settings"
                                              CloseCommand="{Binding CloseAppSettingsCommand}"/>
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Recovery notice (#193). Shown once, the first time this
                                     drawer is opened after startup found DAQifiConfiguration.xml
                                     unreadable and moved it aside. Without it the delimiter has
                                     silently reverted to a comma with nothing saying why. Absent
                                     on every ordinary launch. -->
                                <Border Margin="24,0,24,16"
                                        Padding="10,8"
                                        CornerRadius="3"
                                        Background="#3D2A0A"
                                        BorderBrush="{DynamicResource StatusAmber}"
                                        BorderThickness="1"
                                        IsVisible="{Binding AppSettings.HasRecoveryNotice}">
                                    <TextBlock Text="{Binding AppSettings.RecoveryNotice}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource StatusAmber}"/>
                                </Border>

                                <!-- EXPORT section: the same full-bleed section, caps label and row
                                     label as the flyouts (#615), in place of a label over a rule. -->
                                <Border Classes="drawerSection">
                                <StackPanel>
                                <TextBlock Text="EXPORT" Classes="drawerSectionLabel"/>

                                <StackPanel>
                                    <TextBlock Text="CSV DELIMITER"
                                               Classes="drawerRowLabel"/>
                                    <TextBlock Text="Separates columns when exporting logged sessions to CSV."
                                               Classes="appSettingsHelpText"/>
                                    <Border Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource BorderDim}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="3"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0">
                                        <Grid ColumnDefinitions="Auto,Auto">
                                            <RadioButton Grid.Column="0"
                                                         GroupName="CsvDelimiter"
                                                         Content="COMMA  ,"
                                                         IsChecked="{Binding AppSettings.IsCommaDelimiter, Mode=TwoWay}"
                                                         Theme="{StaticResource SegmentedToggle}"
                                                         ToolTip.Tip="Standard CSV — compatible with most spreadsheets."/>
                                            <RadioButton Grid.Column="1"
                                                         GroupName="CsvDelimiter"
                                                         Content="SEMICOLON  ;"
                                                         IsChecked="{Binding AppSettings.IsSemicolonDelimiter, Mode=TwoWay}"
                                                         Theme="{StaticResource SegmentedToggle}"
                                                         ToolTip.Tip="Use when locale treats comma as decimal separator."/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!--NotificationsFlyout-->
                    <flyouts:NotificationsFlyout IsVisible="{Binding IsNotificationsOpen}"/>

                    <!-- Live Graph Flyout -->
                    <flyouts:LiveGraphFlyout IsVisible="{Binding IsLiveGraphSettingsOpen}"/>

                    <!-- Summary Logger Flyout-->
                    <flyouts:SummaryFlyout IsVisible="{Binding IsLogSummaryOpen}"/>
                </Panel>
                </Border>
            </SplitView.Pane>

            <Grid>
                <TabControl Theme="{StaticResource NavTabControl}"
                            ItemContainerTheme="{StaticResource NavTabItem}"
                            SelectedIndex="{Binding SelectedIndex}">

                    <!-- Live Graph -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="76" Margin="0,14,0,14">
                                <i:Icon Value="mdi-chart-timeline-variant" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Live Graph" Classes="navTabHeaderLabel"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl Content="{Binding}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <prototype:LiveGraphPane/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>

                    <!-- Logged Data -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="76" Margin="0,14,0,14">
                                <i:Icon Value="mdi-database-outline" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Logged Data" Classes="navTabHeaderLabel"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl Content="{Binding}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <prototype:LoggedDataPanePrototype/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>

                    <!-- Channels -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="76" Margin="0,14,0,14">
                                <i:Icon Value="mdi-hub-outline" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Channels" Classes="navTabHeaderLabel"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl Content="{Binding}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <prototype:ChannelsPanePrototype/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>

                    <!-- Devices -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="76" Margin="0,14,0,14">
                                <i:Icon Value="mdi-chip" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Devices" Classes="navTabHeaderLabel"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl Content="{Binding}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <prototype:DevicesPanePrototype/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>

                    <!--profile-->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="76" Margin="0,14,0,14">
                                <i:Icon Value="mdi-tune-variant" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Profiles" Classes="navTabHeaderLabel"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl Content="{Binding}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <local:ProfilesPane/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>

                </TabControl>

                <!-- Busy overlay (MahApps ProgressRing → indeterminate ProgressBar) -->
                <Grid Background="Black" Opacity="0.5" IsVisible="{Binding IsBusy, FallbackValue=False}">
                    <ProgressBar IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                                 Width="200" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

            </Grid>
        </SplitView>
    </Grid>
</Window>
