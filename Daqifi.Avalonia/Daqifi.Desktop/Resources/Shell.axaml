<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="https://github.com/projektanker/icons.avalonia"
                    xmlns:flyouts="using:Daqifi.Desktop.View.Flyouts">
    <!--
        Shared shell chrome — the desktop's navigation rail + segmented toggle,
        promoted out of MainWindow.axaml so BOTH the desktop MainWindow AND the
        mobile LANDSCAPE shell render the identical, token-driven chrome (the
        "shared design language" goal). Mobile portrait uses its own bottom-nav;
        landscape reuses NavTabControl/NavTabItem so it reads ~1:1 with desktop.
        Keyed control themes — opt-in, safe to merge app-wide.
    -->

    <!-- Left navigation rail item: 3px accent stripe on select, raised bg. -->
    <ControlTheme x:Key="NavTabItem" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{TemplateBinding Background}" ColumnDefinitions="3,*">
                    <Rectangle x:Name="AccentStripe"
                               Grid.Column="0"
                               Fill="{DynamicResource Accent}"
                               Opacity="0">
                        <Rectangle.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                            </Transitions>
                        </Rectangle.Transitions>
                    </Rectangle>
                    <ContentPresenter Grid.Column="1"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="^:selected /template/ Rectangle#AccentStripe">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="^:pointerover:not(:selected)">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </ControlTheme>

    <!-- Left navigation rail: vertical item stack + a divider border. -->
    <ControlTheme x:Key="NavTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel/>
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderDim}"
                            BorderThickness="0,0,1,0">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </Border>
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Grid.Column="1"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Segmented toggle (e.g. APP LOGS / DEVICE LOGS). -->
    <ControlTheme x:Key="SegmentedToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Bg" Background="Transparent" CornerRadius="2" Padding="12,7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource SurfaceActive}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </ControlTheme>

    <!-- Navigation rail label (icon + this caption). -->
    <ControlTheme x:Key="NavRailLabel" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </ControlTheme>

    <!-- Round hover-highlight close button (upstream inline Button template). App-wide
         since #613: the settings drawer and the three flyouts all close through it, so
         no close action shows a filled, "checked" accent square. -->
    <ControlTheme x:Key="RoundCloseButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bg">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Bg">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
    </ControlTheme>

    <!-- Right-side panel header (#615): overline, title and round close button, for the
         settings drawer and the three SplitView flyouts alike. The values are the settings
         drawer's, which was the most finished of the two designs: 9px bold TextTertiary
         overline, 22px light title, a 28px RoundCloseButton. The margin puts the title text
         at the 24px column that every panel body below it uses. -->
    <ControlTheme x:Key="{x:Type flyouts:DrawerHeader}" TargetType="flyouts:DrawerHeader">
        <Setter Property="Margin" Value="24,22,16,18"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{TemplateBinding Overline}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiary}"/>
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="22"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="28" Height="28"
                            Theme="{StaticResource RoundCloseButton}"
                            Foreground="{DynamicResource TextSecondary}"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close"
                            Command="{TemplateBinding CloseCommand}">
                        <i:Icon Value="mdi-close" FontSize="16"/>
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Pill buttons — promoted from the prototype views so desktop + mobile share
         one definition. Ghost (outline) / Accent (filled) / Danger (red). -->
    <ControlTheme x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBright}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- Pressed, focus and disabled (#613). The template replaces Fluent's, so
             without these a pill showed no press feedback, no keyboard focus, and a
             disabled pill looked exactly like an enabled one. They apply to the
             Accent and Danger variants too, which are BasedOn this theme. -->
        <Style Selector="^:pressed">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="AccentPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="DangerPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{DynamicResource StatusRed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StatusRed}"/>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource StatusRed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StatusRed}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
