<UserControl x:Class="Daqifi.Desktop.View.Flyouts.LiveGraphFlyout"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:Daqifi.Desktop.ViewModels"
             xmlns:local="using:Daqifi.Desktop.View.Flyouts"
             x:DataType="vm:DaqifiViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource SurfaceRaised}"
             Foreground="{DynamicResource TextPrimary}">

    <!--
        Pane content for the single SplitView flyout host in MainWindow
        (hal: flyout_host). MahApps Flyout chrome lives on the host.
        Brushes come from /Daqifi.Desktop/Resources/DesignTokens.axaml via App.axaml.

        Compiled bindings (issue #327): AvaloniaUseCompiledBindingsByDefault is false in this
        project, so the DataType needs the CompileBindings beside it. The one host is MainWindow's
        SplitView pane, which inherits the window's DaqifiViewModel. One scope, no templates.
    -->

    <!--
        Section, row and switch styles are the app-wide drawer classes in
        Resources/Components.axaml (#615): this pane used to define its own drawerSectionLabel
        at 10px TextTertiary while Log Summary, beside it in the same SplitView pane, used a
        12px TextSecondary one. MahApps ToggleSwitch → Avalonia ToggleSwitch (IsOn → IsChecked);
        the On/Off text stays, as a secondary 11px label (drawerToggle).
    -->
    <UserControl.Styles>
        <Style Selector="ToggleSwitch.drawerToggle">
            <Setter Property="OffContent" Value="Off"/>
            <Setter Property="OnContent" Value="On"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

        <!-- The shared panel header (#615); its look is the DrawerHeader theme in
             Resources/Shell.axaml, the same one the settings drawer uses. -->
        <local:DrawerHeader Grid.Row="0"
                            Overline="LIVE GRAPH"
                            Title="Plot Settings"
                            CloseCommand="{Binding CloseLiveGraphSettingsCommand}"/>

        <!-- ── Grid visibility ── -->
        <Border Grid.Row="1" Classes="drawerSection">
            <StackPanel>
                <TextBlock Text="GRID LINES" Classes="drawerSectionLabel"/>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Major X-Axis" Classes="drawerRowLabel"/>
                    <ToggleSwitch Grid.Column="1" Classes="drawerToggle"
                                  AutomationProperties.Name="Major X-axis grid lines"
                                  IsChecked="{Binding Plotter.ShowingMajorXAxisGrid, Mode=TwoWay}"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Minor X-Axis" Classes="drawerRowLabel"/>
                    <ToggleSwitch Grid.Column="1" Classes="drawerToggle"
                                  AutomationProperties.Name="Minor X-axis grid lines"
                                  IsChecked="{Binding Plotter.ShowingMinorXAxisGrid, Mode=TwoWay}"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Major Y-Axis" Classes="drawerRowLabel"/>
                    <ToggleSwitch Grid.Column="1" Classes="drawerToggle"
                                  AutomationProperties.Name="Major Y-axis grid lines"
                                  IsChecked="{Binding Plotter.ShowingMajorYAxisGrid, Mode=TwoWay}"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Minor Y-Axis" Classes="drawerRowLabel"/>
                    <ToggleSwitch Grid.Column="1" Classes="drawerToggle"
                                  AutomationProperties.Name="Minor Y-axis grid lines"
                                  IsChecked="{Binding Plotter.ShowingMinorYAxisGrid, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Graph precision ── -->
        <Border Grid.Row="2" Classes="drawerSection" BorderThickness="0">
            <StackPanel>
                <TextBlock Text="PRECISION" Classes="drawerSectionLabel"/>

                <Grid ColumnDefinitions="*,Auto">
                    <Slider Grid.Column="0"
                            AutomationProperties.Name="Graph precision"
                            VerticalAlignment="Center"
                            Minimum="0" Maximum="10"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Plotter.Precision}"
                            Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Plotter.Precision}"
                               FontFamily="Consolas"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               MinWidth="20"
                               TextAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
