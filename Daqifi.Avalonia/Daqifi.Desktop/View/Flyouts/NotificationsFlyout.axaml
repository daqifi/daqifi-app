<UserControl x:Class="Daqifi.Desktop.View.Flyouts.NotificationsFlyout"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:Daqifi.Desktop.ViewModels"
             xmlns:local="using:Daqifi.Desktop.View.Flyouts"
             x:DataType="vm:DaqifiViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource SurfaceRaised}">

    <!--
        Pane content for the single SplitView flyout host in MainWindow
        (hal: flyout_host). The MahApps Flyout chrome (Position, Width/Height,
        IsOpen) lives on the host; this control keeps only the header + body.

        Compiled bindings (issue #327): AvaloniaUseCompiledBindingsByDefault is false in this
        project, so the DataType needs the CompileBindings beside it. The one host is MainWindow's
        SplitView pane, which inherits the window's DaqifiViewModel. The notification row template
        declares nothing: its scope is inferred from NotificationList.
    -->

    <Grid RowDefinitions="Auto,*">

        <!-- The shared panel header (#615); its look is the DrawerHeader theme in
             Resources/Shell.axaml, the same one the settings drawer uses. -->
        <local:DrawerHeader Grid.Row="0"
                            Overline="ALERTS"
                            Title="Notifications"
                            CloseCommand="{Binding CloseNotificationsCommand}"/>

        <!--
            Empty state. Sibling of the list in the same row, swapped on HasNotifications the way
            the Logged Data pane swaps on HasLoggingSessions. Uses the app-wide emptyTitle/emptyBody
            classes from Resources/Components.axaml; the icon and the body sentence are the ones the
            mobile notifications overlay (Views/MobileMainView.axaml) already shows for this state,
            so both shells say the same thing.
        -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding !HasNotifications}"
                    Spacing="10"
                    Margin="24,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <i:Icon Value="mdi-bell-check-outline"
                    FontSize="34"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextTertiary}"/>
            <TextBlock Classes="emptyTitle"
                       AutomationProperties.AutomationId="NotificationsEmptyTitle"
                       Text="NO NOTIFICATIONS"/>
            <TextBlock Classes="emptyBody"
                       AutomationProperties.AutomationId="NotificationsEmptyBody"
                       Text="Device and firmware alerts will appear here."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasNotifications}">
            <ItemsControl ItemsSource="{Binding NotificationList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 24px sides, the drawer column (#615); the message at body size,
                             not the 18px it had, which was as large as the panel title. -->
                        <Border Classes="drawerSection">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Message}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap"/>
                            <Button Content="Click here"
                                    IsVisible="{Binding Link, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Tag="{Binding Link}"
                                    Click="Hyperlink_RequestNavigate"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Foreground="{DynamicResource Accent}"
                                    Cursor="Hand"/>
                            <!-- An offered task the app does itself (e.g. importing earlier sessions). -->
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0"
                                        IsVisible="{Binding ActionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Button Content="{Binding ActionText}"
                                        Command="{Binding Action}"
                                        Theme="{StaticResource AccentPillButton}"
                                        Cursor="Hand"/>
                                <Button Content="Dismiss"
                                        Command="{Binding Dismiss}"
                                        IsVisible="{Binding Dismiss, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
