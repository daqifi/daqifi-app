<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Daqifi.Desktop.View.SplashWindow"
        Title="DAQiFi"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <!-- The upstream WPF SplashScreen("Images/DAQiFi.png"): the logo alone, at the image's own
         size, transparent around it. Its lettering is near-black, so a soft shadow just lighter
         than a dark window gives it an edge there; the margin keeps the shadow from clipping. -->
    <Image Source="avares://Daqifi.Avalonia/Daqifi.Desktop/Images/DAQiFi.png"
           Width="776"
           Height="450"
           Margin="24"
           RenderOptions.BitmapInterpolationMode="HighQuality">
        <Image.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="#5A6068" Opacity="1" />
        </Image.Effect>
    </Image>
</Window>
