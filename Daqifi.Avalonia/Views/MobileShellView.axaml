<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Daqifi.Avalonia.Views"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="Daqifi.Avalonia.Views.MobileShellView"
             x:DataType="views:MobileShellViewModel"
             x:CompileBindings="True">
	<!-- Mobile shell (#221 five-platform goal): WiFi discovery + connect on
	     the SAME ported stack the desktop uses. WiFi/TCP only (DIV-UI-003).
	     Styled with the shared DesignTokens + FluentTheme (App.axaml) so it
	     matches the desktop app and the projected panes — no bespoke palette. -->
	<!--
	    x:CompileBindings on the root is what makes the x:DataType above mean
	    anything (issue #326). This view carried x:DataType alone for its whole
	    life, and Daqifi.Avalonia.csproj sets
	    AvaloniaUseCompiledBindingsByDefault=false, so every binding below was
	    still resolved by reflection at run time and no member name in the file
	    was checked by anything. That is worse than declaring neither, because it
	    reads to a maintainer as if the bindings were checked. Measured before
	    this change: renaming the manual-IP box's path to a member that does not
	    exist built with 0 Error(s), 175 Warning(s) — byte-identical to a clean
	    build, and not one diagnostic named it.

	    A broken binding does not blank the control, it leaves the target
	    property at its DEFAULT — and IsVisible defaults to TRUE. Eleven of the
	    29 bindings here feed IsVisible, including ShowChannelSelector,
	    ShowDeviceList and IsUsbAvailable, so a typo in any of them would have
	    shown a pane that is supposed to be hidden rather than hiding one that is
	    supposed to show. "The shell still looks right" could never have caught
	    that; the compiler now does.

	    Each of the two DataTemplates already carried its own x:DataType, which
	    is what a template needs: inside one the DataContext is the item, not
	    this view model. Those declarations are now load-bearing rather than
	    decorative. No subtree here needed checking switched back off — all 29
	    bindings resolve, so the file needs no escape hatch.
	-->
	<UserControl.Styles>
		<!-- The scan button below puts a Panel in its Content and swaps which of
		     two TextBlocks is visible, so its automation peer has no string to fall back
		     on and announces "Avalonia.Controls.Panel" instead of the label (#356). The
		     name has to follow the label rather than be pinned once, which is what the
		     class pair does — the same shape LiveGraphPane.axaml uses to keep the UIA name
		     of its LOGGING ON/OFF readout in step with the text a style writes. -->
		<Style Selector="Button.scanToggle">
			<Setter Property="(AutomationProperties.Name)" Value="Scan for devices"/>
		</Style>
		<Style Selector="Button.scanToggle.scanning">
			<Setter Property="(AutomationProperties.Name)" Value="Stop scanning"/>
		</Style>
		<!-- The stream button has four labels now (#597), so it names itself from the same
		     StreamButtonText its TextBlock shows, and no class pair is needed for its name. Its
		     colour comes from these two styles rather than a local value, which a style cannot
		     override: accent to stream, record-red when the tap records and while it records. -->
		<Style Selector="Button.streamToggle">
			<Setter Property="Background" Value="{DynamicResource Accent}"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.streamToggle.record">
			<Setter Property="Background" Value="{DynamicResource StatusRed}"/>
		</Style>

		<!-- Recording outcome banner: green when a session was saved, amber when nothing was. -->
		<Style Selector="Border.recordOutcome">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusAmber}"/>
		</Style>
		<Style Selector="Border.recordOutcome.saved">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusGreen}"/>
		</Style>

		<!-- The REC dot pulses only while a recording runs: the class, not IsVisible, starts and
		     stops the animation, so a hidden badge costs no frames. -->
		<Style Selector="Ellipse.recDot.live">
			<Style.Animations>
				<Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="0.2"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>

	<Border Background="{DynamicResource Surface}" Padding="20,48,20,24">
		<!-- Scroll so the bottom-docked connect actions (IP row + USB-OTG button) stay
		     reachable when the viewport is short — e.g. phone landscape, where an
		     un-scrolled DockPanel clipped them below the fold (#15). -->
		<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<!-- Cap the content column so a wide landscape/tablet window shows a centered
		     column (like the desktop) instead of edge-to-edge-stretched buttons; more
		     generous than the form panes' 880 so the live plot still gets good width. -->
		<DockPanel MaxWidth="1100" HorizontalAlignment="Center">
			<StackPanel DockPanel.Dock="Top" Spacing="6">
				<TextBlock Text="DAQiFi"
				           FontSize="{DynamicResource FontSizeDisplay}" FontWeight="Bold"
				           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
				<TextBlock x:Name="VersionText"
				           FontSize="{DynamicResource FontSizeCaption}"
				           Foreground="{DynamicResource TextTertiary}"
				           HorizontalAlignment="Center" />
			</StackPanel>

			<Button DockPanel.Dock="Top"
			        Classes="scanToggle"
			        Classes.scanning="{Binding IsScanning}"
			        Command="{Binding ScanCommand}"
			        IsVisible="{Binding !IsStreaming}"
			        HorizontalAlignment="Stretch"
			        HorizontalContentAlignment="Center"
			        Margin="0,20,0,10" Padding="0,14"
			        FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
			        Foreground="White" Background="{DynamicResource Accent}"
			        CornerRadius="10">
				<Panel>
					<TextBlock Text="Scan for devices" IsVisible="{Binding !IsScanning}" />
					<TextBlock Text="Stop scanning" IsVisible="{Binding IsScanning}" />
				</Panel>
			</Button>

			<!-- Stream toggle appears once a device is connected -->
			<Button DockPanel.Dock="Top"
			        Classes="streamToggle"
			        Classes.streaming="{Binding IsStreaming}"
			        Classes.record="{Binding ShowRecordStyle}"
			        AutomationProperties.Name="{Binding StreamButtonText}"
			        Command="{Binding StreamToggleCommand}"
			        IsVisible="{Binding IsConnected}"
			        HorizontalAlignment="Stretch"
			        HorizontalContentAlignment="Center"
			        Margin="0,0,0,10" Padding="0,14"
			        FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
			        Foreground="White"
			        CornerRadius="10">
				<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
					<Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="White"
					         IsVisible="{Binding ShowRecordStyle}" />
					<TextBlock Text="{Binding StreamButtonText}" VerticalAlignment="Center" />
				</StackPanel>
			</Button>

			<!-- What the last recording produced (#597): the saved session and where to find it,
			     or why nothing was kept. Stays until the next stream starts, and through a
			     disconnect, because that is exactly when a user wonders where the data went. -->
			<Border DockPanel.Dock="Top" IsVisible="{Binding HasRecordingOutcome}"
			        Classes="recordOutcome" Classes.saved="{Binding RecordingSaved}"
			        Background="{DynamicResource SurfaceRaised}" BorderThickness="1"
			        CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
					<i:Icon Grid.Column="0" Value="mdi-check-circle" FontSize="20" VerticalAlignment="Center"
					        Foreground="{DynamicResource StatusGreen}" IsVisible="{Binding RecordingSaved}" />
					<i:Icon Grid.Column="0" Value="mdi-alert-circle-outline" FontSize="20" VerticalAlignment="Center"
					        Foreground="{DynamicResource StatusAmber}" IsVisible="{Binding !RecordingSaved}" />
					<TextBlock Grid.Column="1" Text="{Binding RecordingOutcome}" TextWrapping="Wrap"
					           VerticalAlignment="Center"
					           FontSize="{DynamicResource FontSizeLabel}"
					           Foreground="{DynamicResource TextPrimary}" />
				</Grid>
			</Border>

			<!-- Channel + sample-rate picker: shown once connected, before streaming -->
			<Border DockPanel.Dock="Top" IsVisible="{Binding ShowChannelSelector}"
			        Background="{DynamicResource SurfaceRaised}"
			        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
			        CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
				<StackPanel Spacing="10">
					<!-- Record switch (#597). The phone had no way to keep a stream, while APP LOGS
					     said that streamed sessions appear there. On, the next stream is recorded
					     through the desktop's own logging path (LoggingManager + DatabaseLogger),
					     so the session lands in APP LOGS with its plot, export and delete. First
					     in the card so it is in reach without scrolling, in landscape too. -->
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
						<Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
						        Background="{DynamicResource SurfaceActive}" VerticalAlignment="Center">
							<Ellipse Width="12" Height="12" Fill="{DynamicResource StatusRed}"
							         HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
							<TextBlock Text="Record to APP LOGS"
							           FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
							           Foreground="{DynamicResource TextPrimary}" />
							<TextBlock Text="Keep every sample as a session to plot and export."
							           FontSize="{DynamicResource FontSizeCaption}"
							           Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
						</StackPanel>
						<ToggleSwitch Grid.Column="2" IsChecked="{Binding RecordStream}"
						              AutomationProperties.Name="Record to APP LOGS"
						              OnContent="" OffContent="" MinWidth="0"
						              VerticalAlignment="Center" />
					</Grid>
					<Border Height="1" Background="{DynamicResource BorderDim}" />

					<Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
						<TextBlock Grid.Column="0" Text="Rate (Hz):"
						           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"
						           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
						<ComboBox Grid.Column="1" MinWidth="90" HorizontalAlignment="Left"
						          ItemsSource="{Binding AvailableRates}"
						          SelectedItem="{Binding SampleRate}" />
						<Button Grid.Column="2" Content="All" Theme="{StaticResource AccentPillButton}"
						        Command="{Binding SelectAllChannelsCommand}" Margin="0,0,6,0" />
						<Button Grid.Column="3" Content="None" Theme="{StaticResource PillButton}"
						        Command="{Binding SelectNoChannelsCommand}" />
					</Grid>
					<TextBlock Text="Channels to stream:" FontSize="{DynamicResource FontSizeCaption}"
					           Foreground="{DynamicResource TextTertiary}" />
					<ScrollViewer MaxHeight="360">
						<ItemsControl ItemsSource="{Binding Channels}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="2" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="views:ChannelToggle">
									<CheckBox IsChecked="{Binding IsSelected}"
									          Content="{Binding Name}"
									          Foreground="{DynamicResource TextPrimary}"
									          FontSize="{DynamicResource FontSizeBody}"
									          Margin="0,2" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<!-- Plot area is ALWAYS present (not just while streaming) so the Live Graph
			     chrome shows in every state — disconnected, connected, streaming — mirroring
			     the desktop, instead of the pane collapsing to a bare launcher when not
			     streaming (#10). The live plot shows while streaming; otherwise an empty-state
			     skeleton (like the desktop "No channels streaming" card). The connect actions
			     below coexist with it — connect never replaces the plot, and the plot never
			     hides connect. -->
			<Panel DockPanel.Dock="Top" MinHeight="300" Height="360" Margin="0,0,0,10">
				<views:LivePlot x:Name="Plot" IsVisible="{Binding IsStreaming}" />
				<!-- REC badge (#597), in the plot's free top-right corner: the legend owns the
				     top-left and the sample count the bottom-left. -->
				<Border IsVisible="{Binding IsRecording}"
				        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
				        Background="{DynamicResource Surface}"
				        BorderBrush="{DynamicResource StatusRed}" BorderThickness="1"
				        CornerRadius="10" Padding="9,3">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<Ellipse Classes="recDot" Classes.live="{Binding IsRecording}"
						         Width="8" Height="8" VerticalAlignment="Center"
						         Fill="{DynamicResource StatusRed}" />
						<TextBlock Text="REC" VerticalAlignment="Center"
						           FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold"
						           Foreground="{DynamicResource StatusRed}" />
					</StackPanel>
				</Border>
				<Border IsVisible="{Binding !IsStreaming}"
				        Background="{DynamicResource SurfaceRaised}"
				        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
				        CornerRadius="12">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
						<i:Icon Value="mdi-chart-line-variant" FontSize="34"
						        Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" />
						<TextBlock Text="No channels streaming"
						           FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
						           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
						<TextBlock Text="Connect a device and start streaming to see live data."
						           FontSize="{DynamicResource FontSizeCaption}"
						           Foreground="{DynamicResource TextTertiary}"
						           HorizontalAlignment="Center" TextAlignment="Center"
						           TextWrapping="Wrap" MaxWidth="280" />
					</StackPanel>
				</Border>
			</Panel>

			<StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
				<TextBlock Text="{Binding Status}"
				           TextWrapping="Wrap"
				           FontSize="{DynamicResource FontSizeLabel}"
				           Foreground="{DynamicResource TextSecondary}" />
				<!-- Manual IP: AP client-isolation drops broadcast discovery
				     on many networks; connect directly like the desktop app. -->
				<TextBlock Text="Or connect by IP (data port 9760):"
				           FontSize="{DynamicResource FontSizeSmall}"
				           Foreground="{DynamicResource TextTertiary}" />
				<Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="8">
					<!-- Number pad for the address and the port (#589): Number is the pad that has the dot. -->
					<TextBox Grid.Column="0" Text="{Binding ManualIp}"
					         TextInputOptions.ContentType="Number"
					         PlaceholderText="192.168.1.234" FontSize="{DynamicResource FontSizeBody}" />
					<TextBox Grid.Column="1" Text="{Binding ManualPort}"
					         TextInputOptions.ContentType="Digits"
					         FontSize="{DynamicResource FontSizeBody}" />
					<Button Grid.Column="2" Content="Connect" Theme="{StaticResource AccentPillButton}"
					        Command="{Binding ManualConnectCommand}" />
				</Grid>

				<!-- Experimental USB (OTG) connect — shown only on Android (a
				     USB-host connector is registered). Connects the attached DAQiFi
				     over USB-CDC and registers it, lighting up SD offload in the
				     Storage tab. StatusAmber signals the experimental path.
				     See docs/mobile-usb-feasibility.md. -->
				<Button Content="Connect via USB (OTG)"
				        Command="{Binding ConnectUsbCommand}"
				        IsVisible="{Binding IsUsbAvailable}"
				        HorizontalAlignment="Stretch"
				        HorizontalContentAlignment="Center"
				        Margin="0,2,0,0" Padding="0,12"
				        FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
				        Foreground="{DynamicResource Surface}"
				        Background="{DynamicResource StatusAmber}" CornerRadius="8" />
			</StackPanel>

			<ScrollViewer IsVisible="{Binding ShowDeviceList}">
				<ItemsControl ItemsSource="{Binding Devices}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="views:MobileDeviceItem">
							<Button Command="{Binding ConnectCommand}"
							        AutomationProperties.Name="{Binding Name}"
							        HorizontalAlignment="Stretch"
							        HorizontalContentAlignment="Stretch"
							        Margin="0,6" Padding="16,12"
							        Background="{DynamicResource SurfaceRaised}"
							        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
							        CornerRadius="12">
								<StackPanel Spacing="4">
									<TextBlock Text="{Binding Name}"
									           FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
									           Foreground="{DynamicResource TextPrimary}" />
									<TextBlock Text="{Binding Detail}"
									           FontSize="{DynamicResource FontSizeCaption}"
									           Foreground="{DynamicResource TextTertiary}" />
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</DockPanel>
		</ScrollViewer>
	</Border>
</UserControl>
