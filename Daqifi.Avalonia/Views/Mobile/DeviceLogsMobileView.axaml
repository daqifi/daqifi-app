<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:Daqifi.Desktop.ViewModels"
             x:Class="Daqifi.Avalonia.Views.Mobile.DeviceLogsMobileView"
             x:DataType="vm:DeviceLogsViewModel"
             x:CompileBindings="True">
  <!-- Mobile projection of the desktop Device Logs / SD-card pane over the shared
       DeviceLogsViewModel. Styled with the shared component language (pills, chips,
       list rows, mono, empty-state) so it matches the desktop Logged Data pane.

       SD-card offload works over USB and WiFi/TCP (issue #1): DeviceLogsViewModel.CanAccessSdCard
       is true for either connection type, so the callout below only shows when no device is
       connected. Wi-Fi SD offload is a big mobile win — no OTG cable needed.

       Compiled bindings (issue #327): AvaloniaUseCompiledBindingsByDefault is false in this
       project, so the DataType needs the CompileBindings beside it. The one construction site,
       StorageMobileView.OnDeviceLogs, hands this view a new DeviceLogsViewModel. The file-row
       template declares nothing: its scope is inferred from DeviceFiles, and the Import button's
       $parent[ItemsControl].DataContext reaches back out to the view model on its own.

       The device combo's DisplayMemberBinding is a third inferred scope: it resolves against
       ConnectedDevices' item type (IStreamingDevice), not against the DataType above. It is not
       decoration (#462) — a ComboBox told neither DisplayMemberBinding nor ItemTemplate renders
       each item with ToString(), and only DaqifiStreamingDevice (WiFi) overrides that. On
       UsbStreamingDevice the dropdown read
       "Daqifi.Desktop.Device.UsbDevice.UsbStreamingDevice". -->
  <Grid Background="{DynamicResource Surface}">
    <ScrollViewer>
      <StackPanel Classes="paneContent" Spacing="14" Margin="16,20">

        <TextBlock Text="Device Storage" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" />

        <!-- Device selector + connection type -->
        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                CornerRadius="8" Padding="14,12">
          <StackPanel Spacing="8">
            <TextBlock Text="CONNECTED DEVICE" Classes="sectionLabel" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ConnectedDevices}"
                      SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberBinding="{Binding DeviceDisplayName}" />
            <StackPanel Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Border Classes="chip">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="LINK" />
                  <TextBlock Text="{Binding SelectedDevice.ConnectionType}" Classes="chipValue" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding ConnectionTypeMessage}" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="{Binding SdCardStatusLine}" TextWrapping="Wrap"
                       Classes.sdError="{Binding HasSdCardError}"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondary}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.sdError">
                  <Setter Property="Foreground" Value="{DynamicResource StatusRed}" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Refresh" Theme="{StaticResource AccentPillButton}"
                  Command="{Binding RefreshFilesCommand}"
                  IsEnabled="{Binding CanAccessSdCard}" MinHeight="40" />
          <Button Content="Import all" Theme="{StaticResource PillButton}"
                  Command="{Binding ImportAllFilesCommand}"
                  IsEnabled="{Binding CanAccessSdCard}" MinHeight="40" />
        </StackPanel>

        <!-- Import outcome (issue #521).

             The mobile head's only report on a finished import. DeviceLogsViewModel hands every
             outcome to both its inline state and IMessageBoxService; the dialog the latter opens is
             a Window owned by IClassicDesktopStyleApplicationLifetime.MainWindow, so under the
             single-view lifetime this head runs there is nothing to own it and ShowAsync returns
             MessageBoxResult.None without drawing anything. Before this, an import that failed, one
             that succeeded and one that did nothing were pixel-identical on the phone.

             Bound, not a toast: the same affordance as the SD card error panel below and the
             shell's connect-failure status line, and it stays put until dismissed or until the next
             import starts — a transient would be gone before a user who looked away came back,
             which is how the failure in #521 was missed in the first place. -->
        <Border IsVisible="{Binding HasImportOutcome}"
                Background="{DynamicResource SurfaceRaised}"
                BorderThickness="1"
                Classes.outcomeFailed="{Binding ImportOutcomeIsFailure}"
                CornerRadius="8" Padding="16,14">
          <Border.Styles>
            <!-- Default (an import that finished) is green; a failure repaints it red. -->
            <Style Selector="Border">
              <Setter Property="BorderBrush" Value="{DynamicResource StatusGreen}" />
            </Style>
            <Style Selector="Border.outcomeFailed">
              <Setter Property="BorderBrush" Value="{DynamicResource StatusRed}" />
            </Style>
            <Style Selector="Border TextBlock.outcomeHeading">
              <Setter Property="Foreground" Value="{DynamicResource StatusGreen}" />
            </Style>
            <Style Selector="Border.outcomeFailed TextBlock.outcomeHeading">
              <Setter Property="Foreground" Value="{DynamicResource StatusRed}" />
            </Style>
          </Border.Styles>
          <StackPanel Spacing="10">
            <!-- Heading follows the same flag the border does. Text comes from a style pair
                 rather than a converter so the two words live beside the colours they go with —
                 the Classes.x-plus-style shape LiveGraphPane's LOGGING ON/OFF label already uses,
                 and the one MobileAutomationNameTests points at for state-driven labels.

                 AutomationProperties.Name is set alongside each Text for the reason that label
                 records: a TextBlock's automation name does not track Text changed by a style, so
                 without this the heading is in the accessibility tree with the wrong word or none
                 — and the accessibility tree is how #521 was diagnosed in the first place. -->
            <TextBlock Classes="outcomeHeading" FontWeight="SemiBold"
                       Classes.outcomeFailed="{Binding ImportOutcomeIsFailure}"
                       FontSize="{DynamicResource FontSizeBody}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.outcomeHeading">
                  <Setter Property="Text" Value="Import complete" />
                  <Setter Property="(AutomationProperties.Name)" Value="Import complete" />
                </Style>
                <Style Selector="TextBlock.outcomeHeading.outcomeFailed">
                  <Setter Property="Text" Value="Import failed" />
                  <Setter Property="(AutomationProperties.Name)" Value="Import failed" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>
            <TextBlock Text="{Binding ImportOutcomeMessage}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ImportOutcomeText"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextPrimary}" />
            <Button Content="Dismiss" Theme="{StaticResource PillButton}"
                    Command="{Binding ClearImportOutcomeCommand}"
                    HorizontalAlignment="Left" MinHeight="40" />
          </StackPanel>
        </Border>

        <!-- No-device callout: SD offload works once a device is connected (USB or Wi-Fi). -->
        <Border IsVisible="{Binding !CanAccessSdCard}"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource StatusAmber}" BorderThickness="1"
                CornerRadius="8" Padding="16,14">
          <StackPanel Spacing="6">
            <TextBlock Text="Connect a device to browse its SD card"
                       FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource StatusAmber}" />
            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Log files stored on the device SD card can be listed and downloaded over either a Wi-Fi/TCP link or a direct USB-C (OTG) cable. Connect to a DAQiFi device to get started." />
          </StackPanel>
        </Border>

        <!-- SD present but empty -->
        <Border IsVisible="{Binding HasNoFiles}"
                Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="16,14">
          <TextBlock Text="SD card is OK — no log files on it yet."
                     TextWrapping="Wrap" FontSize="{DynamicResource FontSizeLabel}"
                     Foreground="{DynamicResource TextSecondary}" />
        </Border>

        <!-- No SD card installed -->
        <Border IsVisible="{Binding HasSdCardNotPresent}"
                Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="16,14">
          <StackPanel Spacing="10">
            <TextBlock Text="No SD card installed in the device."
                       TextWrapping="Wrap" FontSize="{DynamicResource FontSizeLabel}"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Content="Copy diagnostics" Theme="{StaticResource PillButton}"
                    Command="{Binding CopyDiagnosticInfoCommand}"
                    HorizontalAlignment="Left" MinHeight="40" />
          </StackPanel>
        </Border>

        <!-- Device busy (streaming / SD logging) — neutral, not the red error card (issue #146). -->
        <Border IsVisible="{Binding HasSdCardBusy}"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1"
                CornerRadius="8" Padding="16,14">
          <StackPanel Spacing="10">
            <TextBlock Text="Device busy" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="{Binding SdCardErrorGuidance}" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimary}" />
          </StackPanel>
        </Border>

        <!-- SD card error -->
        <Border IsVisible="{Binding HasSdCardError}"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource StatusRed}" BorderThickness="1"
                CornerRadius="8" Padding="16,14">
          <StackPanel Spacing="10">
            <TextBlock Text="SD card error" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource StatusRed}" />
            <TextBlock Text="{Binding SdCardErrorMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding SdCardErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondary}" />
            <Button Content="Copy diagnostics" Theme="{StaticResource PillButton}"
                    Command="{Binding CopyDiagnosticInfoCommand}"
                    HorizontalAlignment="Left" MinHeight="40" />
          </StackPanel>
        </Border>

        <!-- File list (desktop DataGrid → touch list rows with mono name + chips). -->
        <ItemsControl ItemsSource="{Binding DeviceFiles}" IsVisible="{Binding HasFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="listRow">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding FileName}" Classes="mono"
                               FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                      <Border Classes="chip">
                        <TextBlock Text="{Binding CreatedDateDisplay}" />
                      </Border>
                      <Border Classes="chip">
                        <TextBlock Text="{Binding FormatDisplay}" />
                      </Border>
                      <!-- Size (issue #521). A zero-byte log reads "Empty" and the chip warns:
                           it is the one file on a card that cannot import, and with no size on the
                           row there was nothing to tell it apart from one whose transfer failed.
                           chipWarn has to be a class on the TextBlock, not an inline Foreground —
                           see the comment on that style in Components.axaml. -->
                      <Border Classes="chip">
                        <TextBlock Text="{Binding SizeDisplay}"
                                   Classes.chipWarn="{Binding IsEmpty}" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Import" Theme="{StaticResource AccentPillButton}"
                          Command="{Binding $parent[ItemsControl].DataContext.ImportFileCommand}"
                          CommandParameter="{Binding}"
                          VerticalAlignment="Center" MinHeight="36" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <!-- Busy overlay -->
    <Border IsVisible="{Binding IsBusy}" Background="{DynamicResource Scrim}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
        <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="200" />
        <TextBlock Text="{Binding BusyMessage}" HorizontalAlignment="Center"
                   FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextPrimary}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
