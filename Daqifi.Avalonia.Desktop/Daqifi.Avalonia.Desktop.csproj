<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- From Directory.Build.props, the single place the app's version is declared. -->
		<Version>$(DaqifiAppVersion)</Version>
		<!-- COM interop for the desktop windowing backend (upstream WinExe setting). -->
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Windows executable icon (Explorer, taskbar, alt-tab). Multi-resolution
		     16-256; the small entries carry the traces mark rather than the full
		     lockup, whose wordmark is unreadable below ~64px. Generated by
		     daqifi-design-tokens/assets/app-icons — do not hand-edit. -->
		<ApplicationIcon>..\Daqifi.Avalonia\Daqifi.Desktop\Images\AppIcon.ico</ApplicationIcon>
		<!-- Desktop publish RIDs only. The shared library carries the full
		     restore-graph breadth (incl. android RIDs) for the Android head;
		     this head publishes desktop targets, which the #260 publish gate
		     drives with an explicit `-r`. -->
		<RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
		<!-- Precompile every assembly a desktop publish ships (ReadyToRun, #614). Without it the
		     JIT compiles about 20,500 methods of the app, Avalonia, EF Core, OxyPlot and NLog
		     before the first frame, which was about 77 % of start-up. It acts only at publish, so
		     `dotnet build` and the tests do not change.

		     It is set here, not on the release command line, because the restore must see it too:
		     that is the step that downloads the crossgen2 pack, and the release publishes with
		     no-restore. The crossgen2 pack is a PackageDownload, so it does not go into
		     packages.lock.json.

		     Two conditions keep the restore graph the same on every host:
		     - UseDefaultPublishRuntimeIdentifier=false. Without it, PublishReadyToRun makes the SDK
		       add the HOST RID to RuntimeIdentifiers (RuntimeIdentifierInference.targets). On a
		       linux-arm64 or win-arm64 machine that adds a fifth RID, and the locked restore then
		       fails NU1004 against the four RIDs the lock file records.
		     - R2R only for a restore or a publish with an explicit RID. With that default off, an
		       R2R publish needs a RID, so a RID-less publish stays the portable, IL-only publish
		       that it was before.

		     Tiered compilation and dynamic PGO keep their defaults; the R2R code is re-JIT-ed when
		     it is hot. -->
		<UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
		<PublishReadyToRun Condition="'$(RuntimeIdentifier)' != '' or '$(MSBuildIsRestoring)' == 'true'">true</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>
		<!-- Desktop windowing + startup platform. Program.cs's UsePlatformDetect /
		     StartWithClassicDesktopLifetime live here; the shared library is
		     platform-neutral and must NOT carry this desktop-only package (it
		     would otherwise flow transitively into the Android head). -->
		<PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
		<!-- Installer and self-update (#341, #343). Desktop head only, for the same reason as
		     Avalonia.Desktop: in the shared library it would flow into both mobile heads. -->
		<PackageReference Include="Velopack" Version="1.3.39-g8d2844f" />
	</ItemGroup>

	<ItemGroup>
		<!-- The whole ported app (App.axaml, Views, ViewModels, Services, the
		     ported Daqifi.Desktop logic) rides in as the shared library. -->
		<ProjectReference Include="..\Daqifi.Avalonia\Daqifi.Avalonia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Set -p:DaqifiUpdatesOwnedExternally=true for builds whose channel owns updates, such as
		     a store build (#480). VelopackAppUpdateService then reports updates as owned elsewhere
		     and the app never offers one. -->
		<AssemblyMetadata Include="DaqifiUpdatesOwnedExternally" Value="$(DaqifiUpdatesOwnedExternally)"
		                  Condition="'$(DaqifiUpdatesOwnedExternally)' != ''" />
	</ItemGroup>

	<!-- macOS packaging: turns an `osx-*` publish into a DAQiFi.app bundle (#108). Inert
	     for every other RID, including the RID-less build. See macOS/MacAppBundle.targets
	     for what it emits and what it deliberately does not (signing, #109). -->
	<Import Project="macOS\MacAppBundle.targets" />
</Project>
